    "triage_rules": [
        {
            "id": "severe_breathing",
            "if": {
                "difficulty_breathing": true
            },
            "then": {
                "emergency": true,
                "message": "Difficulty breathing can be a sign of a serious medical emergency. Please seek immediate medical attention or call emergency services."
            },
            "priority": 1
        },
        {
            "id": "severe_chest_pain",
            "if": {
                "chest_pain": true
            },
            "then": {
                "emergency": true,
                "message": "Chest pain can be a sign of a cardiac emergency. Please seek immediate medical attention or call emergency services."
            },
            "priority": 2
        },
        {
            "id": "meningitis_warning",
            "if": {
                "stiff_neck": true,
                "fever": true,
                "headache": true
            },
            "then": {
                "emergency": true,
                "message": "The combination of stiff neck, fever, and headache may indicate meningitis. Please seek immediate medical attention."
            },
            "priority": 3
        },
        {
            "id": "hyperpyrexia",
            "if": {
                "temperature": { ">": 41.0 }
            },
            "then": {
                "emergency": true,
                "message": "A temperature above 41°C (105.8°F) is a medical emergency (hyperpyrexia). Please seek immediate medical attention."
            },
            "priority": 4
        },
        {
            "id": "extreme_tachycardia",
            "if": {
                "heart_rate": { ">": 180 }
            },
            "then": {
                "emergency": true,
                "message": "An extremely high heart rate can be life-threatening. Please seek immediate medical attention."
            },
            "priority": 5
        }
    ],
    "baseline_questions": [
        {
            "id": "age",
            "text": "What is your age?",
            "type": "number",
