            "validation": {
                "min": 0,
                "max": 122
            }
        },
        {
            "id": "sex",
            "text": "What is your sex?",
            "type": "choice",
            "options": [
                "Male",
                "Female",
                "Other"
            ],
            "required": true
        },
        {
            "id": "region",
            "text": "Where are you currently located?",
            "type": "choice",
            "options": [
                "Tropical / Africa / Southeast Asia",
                "South Asia (India, Pakistan)",
                "Temperate (Europe / N. America)"
            ],
            "required": true
        },
        {
            "id": "temperature",
            "text": "Do you know your current body temperature?",
            "type": "number",
            "unit": "°C",
            "required": false,
            "validation": {
                "min": 30,
                "max": 45
            },
            "allow_unknown": true
        },
        {
            "id": "heart_rate",
            "text": "Do you know your current heart rate (pulse)?",
            "type": "number",
            "unit": "bpm",
            "required": false,
            "validation": {
                "min": 20,
                "max": 300
            },
            "allow_unknown": true
        }
    ],
